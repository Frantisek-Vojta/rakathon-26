{
  "expo": {
    "name": "Schránka vzpomínek",
    "slug": "schranka-vzpominek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "schrankavzpominek",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCF7F2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Schránka vzpomínek",
      "shortName": "Schránka",
      "lang": "cs",
      "themeColor": "#FCF7F2",
      "backgroundColor": "#FCF7F2"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FCF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Aplikace potřebuje mikrofon, abyste mohli nahrát hlasový vzkaz."
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikace potřebuje přístup k fotkám, abyste mohli k vzpomínce přidat fotografii nebo video.",
          "cameraPermission": "Aplikace potřebuje fotoaparát, abyste mohli vyfotit fotku nebo natočit video vzkaz.",
          "microphonePermission": "Aplikace potřebuje mikrofon pro natáčení video vzkazu."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
